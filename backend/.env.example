# Copy to ../.env (git-ignored). Keep real keys out of Git and out of the browser.
# Gemini: either name works.
GEMINI_API_KEY=replace-me
# Optional; default is gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
# ElevenLabs voice for the animated guide and the landing-page intro (optional)
ELEVENLABS_API_KEY=replace-me
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
